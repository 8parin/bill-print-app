# Neon PostgreSQL Database URL
# Get this from your Neon dashboard: https://console.neon.tech
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://username:password@host.neon.tech/billprint

# Flask configuration
FLASK_ENV=production
FLASK_DEBUG=0

# App password protection (set in Render dashboard). Leave unset locally to
# disable the login screen.
APP_PASSWORD=your-password-here

# Flask session signing key. REQUIRED when FLASK_ENV=production — app.py
# raises RuntimeError at startup if it's missing, because without a stable
# key every worker restart/redeploy would invalidate all session/sid cookies.
# In Render, render.yaml sets this via `generateValue: true` so you normally
# don't need to set it manually. Not required outside production (falls back
# to a random per-process key).
SECRET_KEY=your-random-secret-key-here

# Output directory for generated bills
OUTPUT_DIR=output/bills